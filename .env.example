# URL del backend Node/Express. En dispositivo fisico usar la IP de la PC en la LAN,
# no localhost (el telefono resuelve localhost contra si mismo).
EXPO_PUBLIC_API_URL=http://192.168.1.35:3000

# Secreto HMAC con el que el backend firma los QR de las entradas.
# Tiene que ser EXACTAMENTE el mismo string que usa el backend al generar la firma.
# OJO: queda incrustado en el bundle de la app y es extraible de un APK.
EXPO_PUBLIC_QR_SECRET=cambiar-por-el-secreto-del-evento
