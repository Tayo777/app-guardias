# URL del backend Node/Express, desplegado en Railway.
#
# OJO: este archivo .env NO se sube a EAS Build (esta en .gitignore), asi que para
# los builds hay que repetir el valor en el bloque "env" de cada perfil de eas.json.
EXPO_PUBLIC_API_URL=https://venta-tickets-production.up.railway.app

# El secreto HMAC de los QR NO se configura aca: llega como qrSecret en la
# respuesta del login y queda guardado en la sesion del guardia (expo-secure-store).
